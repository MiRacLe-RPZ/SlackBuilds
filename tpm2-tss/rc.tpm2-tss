#!/bin/sh

# Start/stop tpm2-tss FAPI runtime directories

EVENTLOG_DIR=/var/run/tpm2-tss/eventlog

start()
{
  if [ ! -d "$EVENTLOG_DIR" ]; then
    mkdir -p "$EVENTLOG_DIR"
    chmod 775 "$EVENTLOG_DIR"
    chown root:tss "$EVENTLOG_DIR"
    echo "Created $EVENTLOG_DIR"
  fi
}

stop()
{
  # tmpfs — cleanup on reboot, nothing to stop
  :
}

case "$1" in

  start)
    start
  ;;

  stop)
    stop
  ;;

  restart)
    stop
    start
  ;;

  *)
    echo "Usage: $0 {start|stop|restart}"
  ;;

esac
