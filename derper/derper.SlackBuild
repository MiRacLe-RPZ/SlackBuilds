# ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

PRGNAM=derper
PKGNAM=${PKGNAM:-$(basename $0 .SlackBuild)}

if [ "x${VERSION}" == "x" ]; then
  INFOFILE="$(pwd)/${PKGNAM}.info"
  if [ -f $INFOFILE ]; then
    source $INFOFILE
  fi
fi

VERSION=${VERSION:-1.104.7}
BUILD=${BUILD:-1}
TAG=${TAG:-_rpz}
PKGTYPE=${PKGTYPE:-txz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

CWD=$(pwd)
TMP=${TMP:-/tmp/rpz}
PKG=$TMP/package-$PKGNAM
OUTPUT=${OUTPUT:-/tmp}
NUMJOBS=${NUMJOBS:-$(( $(getconf _NPROCESSORS_ONLN) + 1 ))}

SRCURL=${DOWNLOAD:-https://github.com/tailscale/tailscale/archive/refs/tags/v${VERSION}.tar.gz}
SOURCE="${CWD}/$(basename $SRCURL)"
if [ ! -e $SOURCE ]; then
  SOURCE="${CWD}/tailscale-${VERSION}.tar.gz"
fi

if [ ! -e $SOURCE ]; then
   SOURCE="${CWD}/tailscale-${VERSION}.tar.gz"
   echo "Downloading '$(basename ${SOURCE})'."
   wget --no-check-certificate -nv -T 30 -O "${SOURCE}" "${SRCURL}" || true
   if [ $? -ne 0 -o ! -s "${SOURCE}" ]; then
      echo "Downloading '$(basename ${SOURCE})' failed... aborting the build."
      mv -f "${SOURCE}" "${SOURCE}.FAIL"
      exit 1
   fi
fi

if ! command -v go >/dev/null 2>&1; then
  echo "Go toolchain is required to build derper."
  exit 1
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf tailscale-$VERSION
tar xvf $SOURCE
cd tailscale-$VERSION
chown -R root:root . || true
chmod -R u+w,go+r-w,a-s .

export GOTOOLCHAIN=${GOTOOLCHAIN:-auto}
export GOCACHE=${GOCACHE:-$TMP/go-cache-$PKGNAM}
export GOPATH=${GOPATH:-$TMP/go-path-$PKGNAM}
export GOMODCACHE=${GOMODCACHE:-$TMP/go-mod-$PKGNAM}
mkdir -p "$GOCACHE" "$GOPATH" "$GOMODCACHE"

GOMAXPROCS=$NUMJOBS go build -trimpath \
  -ldflags "-s -w -X tailscale.com/version.longStamp=${VERSION} -X tailscale.com/version.shortStamp=${VERSION}" \
  -o derper ./cmd/derper

mkdir -p $PKG/usr/bin
install -m755 derper $PKG/usr/bin/derper

mkdir -p $PKG/var/lib/derper
chmod 755 $PKG/var/lib/derper

mkdir -p $PKG/etc/default
cp $CWD/derper.conf $PKG/etc/default/derper.new

mkdir -p $PKG/etc/rc.d
cp $CWD/rc.derper $PKG/etc/rc.d/rc.derper.new
chmod 755 $PKG/etc/rc.d/rc.derper.new

find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

mkdir -p $PKG/usr/doc/${PKGNAM}-${VERSION}
cp -a LICENSE PATENTS cmd/derper/README.md \
  $PKG/usr/doc/${PKGNAM}-${VERSION}/

mkdir -p $PKG/install
cp -a $CWD/slack-desc $CWD/doinst.sh $PKG/install

mkdir -p $PKG/usr/doc/${PKGNAM}-${VERSION}/SlackBuild
cp -a $CWD/$PKGNAM.SlackBuild $CWD/slack-desc $CWD/doinst.sh \
  $CWD/rc.derper $CWD/derper.conf \
  $PKG/usr/doc/${PKGNAM}-${VERSION}/SlackBuild

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PKGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
