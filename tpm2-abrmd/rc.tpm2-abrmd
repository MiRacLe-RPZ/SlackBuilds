#!/bin/sh

# Start/stop tpm2-abrmd (TPM2 Access Broker & Resource Manager Daemon)

TPM2_ABRMD=/usr/sbin/tpm2-abrmd
PIDFILE=/var/run/tpm2-abrmd.pid

start()
{
  if [ -f $PIDFILE ]; then
    echo "$PIDFILE exists, process is already running?"
    exit 1
  fi
  $TPM2_ABRMD --allow-root --tcti=device:/dev/tpmrm0 &
  echo $! > $PIDFILE
}

stop()
{
  if [ -f $PIDFILE ]; then
    kill `cat $PIDFILE`
    rm -f $PIDFILE
  fi
}

case "$1" in

  start)
    start
  ;;

  stop)
    stop
  ;;

  restart)
    stop
    start
  ;;

  *)
    echo "Usage: $0 {start|stop|restart}"
  ;;

esac
