#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

set -e

PRGNAM=adguardvpn-cli
PKGNAM=$(basename $0 .SlackBuild)

INFOFILE="$(pwd)/${PKGNAM}.info"
if [ -f $INFOFILE ]; then
  source $INFOFILE
fi

VERSION=${VERSION:-1.7.12}
BUILD=${BUILD:-1}
TAG=${TAG:-_rpz}
PKGTYPE=${PKGTYPE:-txz}

# Upstream release channel used in the GitHub tag (v$VERSION-$CHANNEL)
CHANNEL=${CHANNEL:-release}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

case "$ARCH" in
  x86_64)  SRCARCH=x86_64 ;;
  aarch64) SRCARCH=aarch64 ;;
  arm)     SRCARCH=armv7 ;;
  *)
    echo "Architecture $ARCH is not supported by upstream binary packages."
    exit 1
    ;;
esac

CWD=$(pwd)
TMP=${TMP:-/tmp/rpz}
PKG=$TMP/package-$PKGNAM
OUTPUT=${OUTPUT:-/tmp}

SRCNAME=${PRGNAM}-${VERSION}-linux-${SRCARCH}.tar.gz
if [ -n "${DOWNLOAD:-}" ] && [ "$SRCARCH" = "x86_64" ]; then
  SOURCE=${CWD}/$(basename "$DOWNLOAD")
else
  SOURCE=${CWD}/${SRCNAME}
fi

if [ ! -f "$SOURCE" ]; then
  echo "Missing source archive: $SOURCE"
  echo "Expected download URL:"
  echo "  https://github.com/AdguardTeam/AdGuardVPNCLI/releases/download/v${VERSION}-${CHANNEL}/${SRCNAME}"
  exit 1
fi

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf ${PRGNAM}-${VERSION}-linux-${SRCARCH}
tar xvf "$SOURCE"
cd ${PRGNAM}-${VERSION}-linux-${SRCARCH}

chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \; -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

install -Dm755 adguardvpn-cli $PKG/usr/bin/adguardvpn-cli

# Upstream completion script is meant to be sourced by bash/zsh
install -Dm644 bash-completion.sh \
  $PKG/usr/share/bash-completion/completions/adguardvpn-cli

mkdir -p $PKG/usr/doc/$PKGNAM-$VERSION
install -Dm644 adguardvpn-cli.sig $PKG/usr/doc/$PKGNAM-$VERSION/adguardvpn-cli.sig
cat $CWD/$PKGNAM.SlackBuild > $PKG/usr/doc/$PKGNAM-$VERSION/$PKGNAM.SlackBuild
cat $CWD/slack-desc > $PKG/usr/doc/$PKGNAM-$VERSION/slack-desc

find $PKG | xargs file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PKGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
