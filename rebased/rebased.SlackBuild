# ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

PRGNAM=rebased
PKGNAM=${PKGNAM:-$(basename $0 .SlackBuild)}

if [ "x${VERSION}" == "x" ]; then
  INFOFILE="$(pwd)/${PKGNAM}.info"
  if [ -f $INFOFILE ]; then
    source $INFOFILE
  fi
fi

VERSION=${VERSION:-1.1.15}
BUILD=${BUILD:-1}
TAG=${TAG:-_rpz}
PKGTYPE=${PKGTYPE:-txz}

case "$(uname -m)" in
  x86_64) LIBDIRSUFFIX="64" ; ARCH=x86_64 ;;
  *) echo "Package for $(uname -m) architecture is not available." ; exit 1 ;;
esac

CWD=$(pwd)
TMP=${TMP:-/tmp/rpz}
PKG=$TMP/package-$PKGNAM
OUTPUT=${OUTPUT:-/tmp}

SRCURL=${DOWNLOAD:-https://github.com/DetachHead/rebased/releases/download/1.1.15/rebased.tar.gz}
SOURCE="${CWD}/$(basename $SRCURL)"

if [ ! -e $SOURCE ]; then
   echo "Downloading '$(basename ${SOURCE})'."
   wget --no-check-certificate -nv -T 30 -O "${SOURCE}" "${SRCURL}" || true
   if [ $? -ne 0 -o ! -s "${SOURCE}" ]; then
      echo "Downloading '$(basename ${SOURCE})' failed... aborting the build."
      mv -f "${SOURCE}" "${SOURCE}.FAIL"
      exit 1
   fi
fi

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $PKG
tar xzf ${SOURCE} || exit 1
chown -R root:root .
chmod -R u+w,go+r-w,a-s .

# The archive extracts into idea-oss/
if [ ! -d $PKG/idea-oss ]; then
  echo "Could not find idea-oss directory in the archive."
  exit 1
fi

# Install to /opt/rebased
mkdir -p $PKG/opt
mv $PKG/idea-oss $PKG/opt/rebased

# Create /usr/bin symlink
mkdir -p $PKG/usr/bin
ln -s /opt/rebased/bin/rebased $PKG/usr/bin/rebased

# Install icons
mkdir -p $PKG/usr/share/icons/hicolor/128x128/apps
cp $PKG/opt/rebased/bin/rebased.png $PKG/usr/share/icons/hicolor/128x128/apps/rebased.png

# Create .desktop file (none shipped in the archive)
mkdir -p $PKG/usr/share/applications
cat > $PKG/usr/share/applications/rebased.desktop <<EOF
[Desktop Entry]
Name=Rebased
Comment=A git client based on the IntelliJ platform
Exec=/usr/bin/rebased %F
Icon=/usr/share/icons/hicolor/128x128/apps/rebased.png
Type=Application
Categories=Development;VersionControl;
Terminal=false
EOF

mkdir -p $PKG/install
cp -a $CWD/slack-desc $CWD/doinst.sh $PKG/install

mkdir -p $PKG/usr/doc/${PKGNAM}-${VERSION}/SlackBuild
cp -a $CWD/$PKGNAM.SlackBuild $CWD/${PKGNAM}-updater $CWD/slack-desc \
  $CWD/doinst.sh $PKG/usr/doc/${PKGNAM}-${VERSION}/SlackBuild

mkdir -p $PKG/etc/cron.daily
cp $CWD/${PKGNAM}-updater $PKG/etc/cron.daily/${PKGNAM}-updater.new
chmod 755 $PKG/etc/cron.daily/${PKGNAM}-updater.new

cd $PKG

/sbin/makepkg -l y -c n $OUTPUT/$PKGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
