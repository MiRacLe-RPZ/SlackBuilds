#  WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF
#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

set -e

PRGNAM=adguardvpn-gui
PKGNAM=$(basename $0 .SlackBuild)

INFOFILE="$(pwd)/${PKGNAM}.info"
if [ -f $INFOFILE ]; then
  source $INFOFILE
fi

VERSION=${VERSION:-1.0.0}
BUILD=${BUILD:-2}
TAG=${TAG:-_rpz}
PKGTYPE=${PKGTYPE:-txz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
elif [ "$ARCH" = "aarch64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

CWD=$(pwd)
TMP=${TMP:-/tmp/rpz}
PKG=$TMP/package-$PKGNAM
OUTPUT=${OUTPUT:-/tmp}
NUMJOBS=${NUMJOBS:-$(( $(getconf _NPROCESSORS_ONLN) + 1 ))}

SOURCE=${CWD}/$(basename "$DOWNLOAD")

if [ ! -f "$SOURCE" ]; then
  echo "Missing source archive: $SOURCE"
  echo "Download from: $DOWNLOAD"
  exit 1
fi

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION
tar xvf "$SOURCE"
cd $PRGNAM-$VERSION

chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \; -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

# Look for packaged askpass helper under /usr/bin (Slackware FHS)
sed -i 's|"/usr/local/bin/adguard-vpn-askpass".to_string(),|"/usr/bin/adguard-vpn-askpass".to_string(),\n            "/usr/local/bin/adguard-vpn-askpass".to_string(),|' \
  src/cli_wrapper.rs

# Keep cargo cache out of the real $HOME
export CARGO_HOME=$TMP/cargo-home-$PKGNAM
export CARGO_TARGET_DIR=$TMP/cargo-target-$PKGNAM
export CARGO_INCREMENTAL=0
mkdir -p "$CARGO_HOME" "$CARGO_TARGET_DIR"

export CFLAGS="$SLKCFLAGS"
export CXXFLAGS="$SLKCFLAGS"

# Network access is required here to fetch crates (same approach as Arch PKGBUILD).
# Build-time deps: rust/cargo, fontconfig, libxkbcommon, Qt5/Qt6 development headers.
# Slint pulls a large dependency tree (incl. Skia); ensure plenty of free disk under $TMP.
cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
CFLAGS="$SLKCFLAGS" CXXFLAGS="$SLKCFLAGS" \
  cargo build --frozen --release -j "$NUMJOBS"

install -Dm755 "$CARGO_TARGET_DIR/release/adguardvpn-gui" \
  $PKG/usr/bin/adguardvpn-gui
ln -sf adguardvpn-gui $PKG/usr/bin/adguard-vpn-gui

# Graphical askpass helper used when elevating adguardvpn-cli
install -Dm755 data/adguard-vpn-askpass $PKG/usr/bin/adguard-vpn-askpass

install -Dm644 data/adguardvpn-gui.desktop \
  $PKG/usr/share/applications/adguardvpn-gui.desktop
install -Dm644 data/icons/adguardvpn-gui.svg \
  $PKG/usr/share/icons/hicolor/scalable/apps/adguardvpn-gui.svg

# Polkit: require auth_admin (upstream allow_active=yes + YES for wheel skipped
# the password dialog). Rules/policy come from this SlackBuild directory.
install -Dm644 $CWD/org.kde.plasma.adguardvpn.policy \
  $PKG/usr/share/polkit-1/actions/org.kde.plasma.adguardvpn.policy
install -Dm644 $CWD/10-adguardvpn.rules \
  $PKG/etc/polkit-1/rules.d/10-adguardvpn.rules.new

# sudoers: NOPASSWD for adguardvpn-cli (CLI uses "sudo -b" without -A;
# graphical askpass cannot work reliably for that path — see sudoers.adguardvpn)
install -Dm440 $CWD/sudoers.adguardvpn \
  $PKG/etc/sudoers.d/zz-adguardvpn.new

find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

mkdir -p $PKG/usr/doc/$PKGNAM-$VERSION
cp -a LICENSE README.md $PKG/usr/doc/$PKGNAM-$VERSION/
cp -a $CWD/sudoers.adguardvpn $CWD/10-adguardvpn.rules \
  $CWD/org.kde.plasma.adguardvpn.policy \
  $PKG/usr/doc/$PKGNAM-$VERSION/
cat $CWD/$PKGNAM.SlackBuild > $PKG/usr/doc/$PKGNAM-$VERSION/$PKGNAM.SlackBuild
cat $CWD/slack-desc > $PKG/usr/doc/$PKGNAM-$VERSION/slack-desc

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh
if [ -f $CWD/slack-required ]; then
  cat $CWD/slack-required > $PKG/install/slack-required
fi

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PKGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
