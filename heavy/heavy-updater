#!/bin/sh

case "$(uname -m)" in
  x86_64) ARCH=x86_64 ;;
  *) echo "Package for $(uname -m) architecture is not available." ; exit 1 ;;
esac

LATEST=$(curl -s https://api.github.com/repos/mokevnin/heavy/releases/latest | grep '"tag_name"' | head -1 | cut -d'"' -f4 | sed 's/^v//')
CURRENT=$(ls /var/log/packages/ 2>/dev/null | grep "^heavy-" | cut -d"-" -f2)

if [ -n "$LATEST" ] && [ "x$LATEST" != "x$CURRENT" ]; then
    BUILD="1"
    TAG="_auto"
    PKGNAM=$(basename $0 -updater)
    VERSION=${LATEST}
    ( cd /usr/share/doc/heavy-${CURRENT}/SlackBuild \
      && source ./heavy.SlackBuild \
      && /sbin/upgradepkg /tmp/heavy-$LATEST-$ARCH-$BUILD$TAG.txz \
      && cd /usr/share/doc/heavy-${CURRENT}/SlackBuild \
      && rm -f heavy-x86_64-unknown-linux-gnu.tar.xz
    )
fi
