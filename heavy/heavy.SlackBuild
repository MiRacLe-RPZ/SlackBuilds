PRGNAM=heavy
PKGNAM=${PKGNAM:-$(basename $0 .SlackBuild)}

if [ "x${VERSION}" == "x" ]; then
  INFOFILE="$(pwd)/${PKGNAM}.info"
  if [ -f $INFOFILE ]; then
    source $INFOFILE
  fi
fi

VERSION=${VERSION:-0.1.2}
BUILD=${BUILD:-1}
TAG=${TAG:-_rpz}
PKGTYPE=${PKGTYPE:-txz}

case "$(uname -m)" in
  x86_64) LIBDIRSUFFIX="64" ; ARCH=x86_64 ;;
  *) echo "Package for $(uname -m) architecture is not available." ; exit 1 ;;
esac

CWD=$(pwd)
TMP=${TMP:-/tmp/rpz}
PKG=$TMP/package-$PKGNAM
OUTPUT=${OUTPUT:-/tmp}

SRCURL=${DOWNLOAD:-https://github.com/mokevnin/heavy/releases/download/v$VERSION/heavy-x86_64-unknown-linux-gnu.tar.xz}
SOURCE="${CWD}/$(basename $SRCURL)"

if [ ! -e $SOURCE ]; then
   echo "Downloading '$(basename ${SOURCE})'."
   wget --no-check-certificate -nv -T 30 -O "${SOURCE}" "${SRCURL}" || true
   if [ $? -ne 0 -o ! -s "${SOURCE}" ]; then
      echo "Downloading '$(basename ${SOURCE})' failed... aborting the build."
      mv -f "${SOURCE}" "${SOURCE}.FAIL"
      exit 1
   fi
fi

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf heavy-x86_64-unknown-linux-gnu
tar -xJf $SOURCE
cd heavy-x86_64-unknown-linux-gnu
chown -R root:root .
chmod -R u+w,go+r-w,a-s .

mkdir -p $PKG/usr/bin
install -m755 heavy $PKG/usr/bin/heavy

find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

mkdir -p $PKG/usr/share/doc/${PKGNAM}-${VERSION}
cp -a README.md CHANGELOG.md LICENSE $PKG/usr/share/doc/${PKGNAM}-${VERSION}/

mkdir -p $PKG/install
cp -a $CWD/slack-desc $CWD/doinst.sh $PKG/install

mkdir -p $PKG/usr/share/doc/${PKGNAM}-${VERSION}/SlackBuild
cp -a $CWD/$PKGNAM.SlackBuild $CWD/${PKGNAM}-updater $CWD/slack-desc $CWD/doinst.sh \
  $PKG/usr/share/doc/${PKGNAM}-${VERSION}/SlackBuild

mkdir -p $PKG/etc/cron.daily
cp $CWD/${PKGNAM}-updater $PKG/etc/cron.daily/${PKGNAM}-updater.new
chmod 755 $PKG/etc/cron.daily/${PKGNAM}-updater.new

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PKGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
